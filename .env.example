# Copiar a .env (no se versiona) y completar con valores locales.
# En Kubernetes estos valores se inyectan como SealedSecrets (ver scripts/seal-secrets.sh).

VITE_API_URL=/api
REDIS_URL=redis://finflow-redis:6339/0

UNLEASH_DB_NAME=unleash_system
UNLEASH_DB_USER=unleash
UNLEASH_DB_PASSWORD=change-me
UNLEASH_APP_NAME=finflow
UNLEASH_SECRET_TOKEN=change-me

DATABASE_URL=postgres://unleash:change-me@unleash-db:5432/unleash_system
DB_PATH=postgres://unleash:change-me@unleash-db:5432/unleash_system
