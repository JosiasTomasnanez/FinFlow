    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Logs - FinFlow Backend (Loki)",
      "type": "row"
    },
    {
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "Volumen de Logs (líneas/seg)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate({k8s_namespace_name=~\"$namespace\", k8s_container_name=\"finflow-app\"}[1m]))",
          "legendFormat": "Líneas/seg",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Errores (status >= 500) /seg",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate({k8s_namespace_name=~\"$namespace\", k8s_container_name=\"finflow-app\"} | json | status >= 500 [1m])) or vector(0)",
          "legendFormat": "Errores 5xx",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "Latencia p95 (desde logs)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {k8s_namespace_name=~\"$namespace\", k8s_container_name=\"finflow-app\"} | json | unwrap latency_ms [5m])",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 4,
      "title": "1. Requests por Código HTTP (desde logs)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50
          },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({k8s_namespace_name=~\"$namespace\", k8s_container_name=\"finflow-app\"} | json [1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 5,
      "title": "2. Latencia: Percentiles p50, p90, p95, p99 (desde logs)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          },
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.50, {k8s_namespace_name=~\"$namespace\", k8s_container_name=\"finflow-app\"} | json | unwrap latency_ms [5m])",
          "legendFormat": "p50 (Mediana)",
          "refId": "A"
        },
        {
          "expr": "quantile_over_time(0.90, {k8s_namespace_name=~\"$namespace\", k8s_container_name=\"finflow-app\"} | json | unwrap latency_ms [5m])",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "quantile_over_time(0.95, {k8s_namespace_name=~\"$namespace\", k8s_container_name=\"finflow-app\"} | json | unwrap latency_ms [5m])",
          "legendFormat": "p95",
          "refId": "C"
        },
        {
          "expr": "quantile_over_time(0.99, {k8s_namespace_name=~\"$namespace\", k8s_container_name=\"finflow-app\"} | json | unwrap latency_ms [5m])",
          "legendFormat": "p99",
          "refId": "D"
        }
      ]
    }
  ],
